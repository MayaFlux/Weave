import { HorizontalBox, VerticalBox } from "std-widgets.slint";
import { WeaveTheme } from "./theme.slint";
import { AppButton } from "./components.slint";

export component ConfirmationDialog inherits Rectangle {
    in property <string> title;
    in property <string> message;
    callback confirm;
    callback cancel;

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    z: 110;
    background: WeaveTheme.overlay.with-alpha(0.82);
    TouchArea { }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 540px;
        height: 250px;
        border-radius: 6px;
        border-width: 1px;
        border-color: WeaveTheme.border-strong;
        background: WeaveTheme.panel-background;
        VerticalBox {
            x: 28px; y: 26px; width: parent.width - 56px; height: parent.height - 52px; spacing: 14px;
            Text { text: "REPLACE INSTALLED EDITION?"; color: WeaveTheme.warning-text; font-size: WeaveTheme.font-tiny; font-weight: 700; }
            Text { text: root.title; color: WeaveTheme.text-primary; font-size: WeaveTheme.font-dialog-title; font-weight: 650; wrap: word-wrap; }
            Text { text: root.message; color: WeaveTheme.text-body; font-size: WeaveTheme.font-small; wrap: word-wrap; vertical-stretch: 1; }
            HorizontalBox {
                spacing: 12px;
                AppButton { text: "Cancel"; clicked => { root.cancel(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                AppButton { text: "Replace and Install"; primary: true; clicked => { root.confirm(); } }
            }
        }
    }
}
