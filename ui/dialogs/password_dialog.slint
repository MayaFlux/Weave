import { Button, HorizontalBox, VerticalBox } from "std-widgets.slint";
import { WeaveTheme } from "../theme.slint";
import { HintLineEdit } from "../components/hint_line_edit.slint";

export component PasswordDialog inherits Rectangle {
    in-out property <string> password;
    in property <string> channel;
    callback confirm;
    callback cancel;

    width: 100%;
    height: 100%;
    z: 110;
    background: WeaveTheme.overlay.with-alpha(0.82);
    TouchArea { }
    Rectangle {
        width: min(600px, parent.width - 32px);
        height: min(body.preferred-height + 80px, parent.height - 32px);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: 6px;
        border-width: 1px;
        border-color: WeaveTheme.border-strong;
        background: WeaveTheme.panel-background;
        body := VerticalBox {
            x: 28px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 56px;
            height: self.preferred-height;
            spacing: 14px;
            Text {
                text: "AUTHORIZE INSTALLATION";
                color: WeaveTheme.accent;
                font-size: WeaveTheme.font-tiny;
                font-weight: 700;
            }
            Text {
                text: "Install MayaFlux (" + (root.channel == "development" ? "Development" : "Stable") + ")";
                color: WeaveTheme.text-primary;
                font-size: WeaveTheme.font-dialog-title;
                font-weight: 650;
            }
            Text {
                text: "Enter your sudo password for package installation. Weave clears it when the operation ends. Project and community work do not need it.";
                color: WeaveTheme.text-body;
                font-size: WeaveTheme.font-body;
                preferred-width: 0px;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            HintLineEdit {
                text <=> root.password;
                input-type: InputType.password;
                hint: "sudo password";
            }
            HorizontalBox {
                spacing: 12px;
                Button { text: "Cancel"; clicked => { root.cancel(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                Button {
                    text: "Install";
                    primary: true;
                    enabled: !root.password.is-empty;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
