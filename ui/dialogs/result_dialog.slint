import { Button, HorizontalBox, TextEdit, VerticalBox } from "std-widgets.slint";
import { WeaveTheme } from "../theme.slint";
import { CompletionNotice } from "../components/completion_notice.slint";

export component ResultDialog inherits Rectangle {
    in property <int> result_kind;
    in property <string> result_title;
    in property <string> result_message;
    in property <bool> result_busy;
    in property <bool> cancel_enabled: false;
    in property <bool> retry_visible: false;
    callback close;
    callback cancel;
    callback retry;

    x: 0px;
    y: 0px;
    width: 100%;
    height: 100%;
    z: 100;
    background: WeaveTheme.overlay.with-alpha(0.78);
    TouchArea { }
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(720px, parent.width - 32px);
        height: min(root.result_busy ? 520px : 420px, parent.height - 32px);
        border-radius: 6px;
        border-width: 1px;
        border-color: WeaveTheme.border-strong;
        background: WeaveTheme.panel-background;
        VerticalBox {
            x: 28px; y: 26px; width: parent.width - 56px; height: parent.height - 52px; spacing: 12px;
            CompletionNotice {
                kind: root.result_kind;
                busy: root.result_busy;
                heading: root.result_title;
            }
            Rectangle { height: 1px; background: WeaveTheme.border; }
            Rectangle {
                vertical-stretch: 1;
                background: WeaveTheme.window-background;
                log_text := TextEdit {
                    x: 10px; y: 8px;
                    width: parent.width - 20px; height: parent.height - 16px;
                    read-only: true;
                    text: root.result_message;
                    font-size: WeaveTheme.font-small;
                    wrap: word-wrap;
                    content-y: root.result_busy ? min(0px, self.visible-height - self.content-height) : 0px;
                    accessible-label: "Operation output";
                }
            }
            HorizontalBox {
                Rectangle { horizontal-stretch: 1; background: transparent; }
                if root.cancel_enabled: Button { text: "Cancel"; enabled: root.result_busy; clicked => { root.cancel(); } }
                if root.retry_visible: Button { text: "Retry"; enabled: !root.result_busy; clicked => { root.retry(); } }
                Button { text: "Close"; primary: true; enabled: !root.result_busy; clicked => { root.close(); } }
            }
        }
    }
}
