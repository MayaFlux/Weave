import { Button, CheckBox, GroupBox, ProgressIndicator, RadioGroup, VerticalBox } from "std-widgets.slint";
import { WeaveTheme } from "../theme.slint";

export component InstallMayaFluxScreen inherits VerticalBox {
    in property <bool> busy;
    in property <bool> linux_install;
    in property <bool> windows_install;
    in-out property <string> install_channel;
    in-out property <bool> install_cli_access;
    callback back;
    callback install_mayaflux(string);
    callback prepare_install_mayaflux(string);

    spacing: 18px;
    Text { text: "Install MayaFlux"; color: WeaveTheme.accent; font-size: WeaveTheme.font-heading; font-weight: 650; }
    Text {
        text: root.windows_install
            ? "Install MayaFlux and its build environment. Windows requests administrator consent for installation. Internet access and several GB of free space are required."
            : root.linux_install
            ? "Install MayaFlux using your distribution's package manager. Package dependencies are handled by the package manager."
            : "Check Apple developer tools and Homebrew, then install MayaFlux and its dependencies through Homebrew. Missing prerequisites may open a native macOS installer.";
        color: WeaveTheme.text-secondary;
        font-size: WeaveTheme.font-body;
        preferred-width: 0px;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    GroupBox {
        title: "Install options";
        vertical-stretch: 0;
        VerticalBox {
            spacing: 16px;
            RadioGroup {
                title: "Release channel";
                orientation: horizontal;
                enabled: !root.busy;
                RadioButton { text: "Stable"; checked: root.install_channel == "stable"; }
                RadioButton { text: "Development"; checked: root.install_channel == "development"; }
                selected(value) => { root.install_channel = value == "Stable" ? "stable" : "development"; }
            }

            Text {
                text: "Stable: Current release, recommended for most projects. Development: Latest development build.";
                color: WeaveTheme.text-body;
                font-size: WeaveTheme.font-body;
                preferred-width: 0px;
                horizontal-stretch: 1;
                wrap: word-wrap;
            }
            CheckBox {
                text: "Make the Weave CLI available in new terminals";
                checked <=> root.install_cli_access;
                enabled: !root.busy;
            }
            Button {
                text: root.linux_install ? "Continue" : "Install";
                primary: true;
                enabled: !root.busy;
                clicked => {
                    if root.linux_install { root.prepare_install_mayaflux(root.install_channel); }
                    else { root.install_mayaflux(root.install_channel); }
                }
            }
        }
    }
    if root.busy: ProgressIndicator { indeterminate: true; }
    Rectangle { vertical-stretch: 1; background: transparent; }
    Text {
        text: root.windows_install
            ? "System check → MayaFlux → Dependencies → Environment → Templates / CLI"
            : root.linux_install
            ? "System check → MayaFlux → Templates / CLI"
            : "System check → MayaFlux → Environment → Templates / CLI";
        color: WeaveTheme.text-secondary;
        font-size: WeaveTheme.font-caption;
        preferred-width: 0px;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    Text {
        text: "Weave asks before replacing another MayaFlux edition. Templates are built into Weave; the same executable provides the GUI and CLI.";
        color: WeaveTheme.text-muted;
        font-size: WeaveTheme.font-caption;
        preferred-width: 0px;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    Button { text: "Back"; enabled: !root.busy; clicked => { root.back(); } }
}
