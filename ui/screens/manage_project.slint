import { HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";
import { WeaveTheme } from "../theme.slint";
import { AppButton } from "../components/mod.slint";

export component ManageProjectScreen inherits VerticalBox {
    in-out property <string> project_path;
    in-out property <string> module_names;
    in property <bool> busy;
    callback back;
    callback add_community_modules;

    spacing: 14px;
    AppButton { text: "←  Projects"; clicked => { root.back(); } }
    Text { text: "Manage Project"; color: WeaveTheme.accent; font-size: WeaveTheme.font-heading; font-weight: 650; }
    Text { text: "Manage this existing project and add community modules."; color: WeaveTheme.text-secondary; font-size: WeaveTheme.font-description; }
    Rectangle {
        height: 250px;
        background: WeaveTheme.panel-background;
        border-width: 1px;
        border-color: WeaveTheme.border;
        border-radius: 6px;
        VerticalBox {
            x: 24px; y: 22px; width: parent.width - 48px; height: parent.height - 44px; spacing: 12px;
            Text { text: "PROJECT FOLDER"; color: WeaveTheme.accent; font-size: WeaveTheme.font-tiny; font-weight: 700; }
            Text { text: root.project_path; color: WeaveTheme.text-primary; vertical-alignment: center; overflow: elide; }
            Text { text: "COMMUNITY MODULES"; color: WeaveTheme.accent; font-size: WeaveTheme.font-tiny; font-weight: 700; }
            LineEdit { text <=> root.module_names; placeholder-text: "terrain_field, audio_tools"; }
            Text { text: "Weave checks registry and MayaFlux compatibility, validates module files, then registers the modules in community.cmake."; color: WeaveTheme.text-secondary; font-size: WeaveTheme.font-small; wrap: word-wrap; }
        }
    }
    HorizontalBox {
        AppButton { text: "Back"; clicked => { root.back(); } }
        Rectangle { horizontal-stretch: 1; background: transparent; }
        AppButton { text: root.busy ? "Adding…" : "Add Community Modules"; primary: true; enabled: !root.busy; clicked => { root.add_community_modules(); } }
    }
}
