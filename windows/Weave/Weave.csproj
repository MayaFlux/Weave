<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Weave</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <!-- Root namespace for all classes -->
  <PropertyGroup>
    <RootNamespace>Weave</RootNamespace>
  </PropertyGroup>

  <!-- Embed templates from root (shared across platforms) -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\templates\**\*">
      <Link>Resources/templates/%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Embed scripts from windows/scripts -->
  <ItemGroup>
    <EmbeddedResource Include="..\scripts\*">
      <Link>Resources/scripts/%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>