<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Weave</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Weave</RootNamespace>
  </PropertyGroup>

<ItemGroup>
    <EmbeddedResource Include="..\..\templates\CMakeLists.txt">
      <Link>Resources/templates/CMakeLists.txt</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\shaders.cmake">
      <Link>Resources/templates/shaders.cmake</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\main.cpp">
      <Link>Resources/templates/main.cpp</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\user_project.hpp">
      <Link>Resources/templates/user_project.hpp</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\vscode\settings.json">
      <Link>Resources/templates/vscode/settings.json</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\vscode\tasks.json">
      <Link>Resources/templates/vscode/tasks.json</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\templates\vscode\launch.json">
      <Link>Resources/templates/vscode/launch.json</Link>
    </EmbeddedResource>
    
    <EmbeddedResource Include="..\..\windows\scripts\install_package.ps1">
      <Link>Resources/scripts/install_package.ps1</Link>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\windows\scripts\packages.psd1">
      <Link>Resources/scripts/packages.psd1</Link>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
