#!/usr/bin/env zsh
# Weave Postinstall Script - Runs after .pkg file extraction
# This script: downloads MayaFlux, installs dependencies, sets up environment

set -euo pipefail

# ============================================================================
# CONFIGURATION
# ============================================================================

MAYAFLUX_REPO="MayaFlux/MayaFlux"
WEAVE_BIN="$HOME/.local/bin"
INSTALLER_LOG="$HOME/.weave_install.log"

# Determine installation location based on where we're being installed
# When user selects "install for current user": $2 = $HOME
# When user selects "system-wide": $2 = /
INSTALL_TARGET="${2:-.}"

if [[ "$INSTALL_TARGET" == "/" ]]; then
    # System-wide installation
    MAYAFLUX_INSTALL_DIR="/Library/MayaFlux"
    WEAVE_LOCATION="/Library/Weave"
else
    # User-level installation (regardless of what $2 is)
    MAYAFLUX_INSTALL_DIR="$INSTALL_TARGET/MayaFlux"
    WEAVE_LOCATION="$INSTALL_TARGET/Library/Weave"
fi

# ============================================================================
# SETUP ERROR HANDLING
# ============================================================================

cleanup() {
    local EXIT_CODE=$?
    if [ $EXIT_CODE -ne 0 ]; then
        log "❌ Installation failed with exit code $EXIT_CODE"
        log "For manual troubleshooting, check: $INSTALLER_LOG"
    fi
    return $EXIT_CODE
}

trap cleanup EXIT

# ============================================================================
# UTILITIES
# ============================================================================

log() {
    echo "[Weave] $*" | tee -a "$INSTALLER_LOG"
}

error() {
    echo "[Weave ERROR] $*" | tee -a "$INSTALLER_LOG" >&2
    exit 1
}

check_command() {
    command -v "$1" >/dev/null 2>&1
}

# Initialize log
{
    echo "=========================================="
    echo "Weave Installation Log"
    echo "Started: $(date)"
    echo "=========================================="
    echo ""
    echo "Installation directory: $MAYAFLUX_INSTALL_DIR"
    echo "User: $(whoami)"
    echo "Home: $HOME"
    echo ""
} >>"$INSTALLER_LOG"

log "MayaFlux will be installed to: $MAYAFLUX_INSTALL_DIR"

# ============================================================================
# CHECK PERMISSIONS
# ============================================================================

case "$MAYAFLUX_INSTALL_DIR" in
/Library/*)
    log "System-wide installation detected"
    if [ ! -w /Library ]; then
        error "Cannot write to /Library - insufficient permissions. Try user-level installation instead."
    fi
    ;;
$HOME/*)
    log "User-level installation detected"
    if [ ! -w "$HOME" ]; then
        error "Cannot write to home directory - insufficient permissions"
    fi
    ;;
*)
    error "Invalid installation path: $MAYAFLUX_INSTALL_DIR"
    ;;
esac

# ============================================================================
# STEP 1: CHECK IF MAYAFLUX ALREADY INSTALLED
# ============================================================================

if [ -d "$MAYAFLUX_INSTALL_DIR" ] && [ -f "$MAYAFLUX_INSTALL_DIR/lib/libMayaFluxLib.dylib" ]; then
    INSTALLED_VERSION=$(cat "$MAYAFLUX_INSTALL_DIR/.version" 2>/dev/null || echo "unknown")
    log "ℹ️  MayaFlux already installed (version: $INSTALLED_VERSION)"
    log "Skipping download. To reinstall, remove $MAYAFLUX_INSTALL_DIR first."
    SKIP_DOWNLOAD=true
else
    SKIP_DOWNLOAD=false
fi

# ============================================================================
# STEP 2: DOWNLOAD LATEST MAYAFLUX RELEASE
# ============================================================================

if [ "$SKIP_DOWNLOAD" = false ]; then
    log "Downloading latest MayaFlux release..."

    TMPDIR_DOWNLOAD=$(mktemp -d) || error "Failed to create temp directory"
    trap 'rm -rf "$TMPDIR_DOWNLOAD"' EXIT

    # Fetch releases from GitHub API
    log "Fetching from GitHub API..."
    RELEASES=$(curl -fsSL "https://api.github.com/repos/MayaFlux/MayaFlux/releases" 2>&1) || error "Failed to fetch releases"

    TAG_NAME=$(echo "$RELEASES" | grep -o '"tag_name": *"[^"]*"' | head -1 | sed 's/"tag_name": *"\([^"]*\)"/\1/')

    if [ -z "$TAG_NAME" ]; then
        error "Could not find release tag"
    fi

    log "Latest release: $TAG_NAME"

    # Find macOS asset (tar.gz preferred, then zip)
    ASSET_NAME=$(echo "$RELEASES" | grep -o '"name": *"MayaFlux-[^"]*macos[^"]*\.tar\.gz"' | head -1 | sed 's/"name": *"\([^"]*\)"/\1/')

    if [ -z "$ASSET_NAME" ]; then
        ASSET_NAME=$(echo "$RELEASES" | grep -o '"name": *"MayaFlux-[^"]*macos[^"]*\.zip"' | head -1 | sed 's/"name": *"\([^"]*\)"/\1/')
    fi

    if [ -z "$ASSET_NAME" ]; then
        error "No macOS asset found for release $TAG_NAME"
    fi

    log "Asset: $ASSET_NAME"

    # Extract download URL from JSON
    ASSET_URL=$(echo "$RELEASES" | grep -A 2 "\"name\": \"$ASSET_NAME\"" | grep -o '"browser_download_url": *"[^"]*"' | head -1 | sed 's/"browser_download_url": *"\([^"]*\)"/\1/')

    if [ -z "$ASSET_URL" ]; then
        error "Could not find download URL for asset: $ASSET_NAME"
    fi

    log "Downloading from: $ASSET_URL"

    # Determine file extension
    if [[ "$ASSET_NAME" == *.tar.gz ]]; then
        DOWNLOAD_FILE="$TMPDIR_DOWNLOAD/release.tar.gz"
    elif [[ "$ASSET_NAME" == *.zip ]]; then
        DOWNLOAD_FILE="$TMPDIR_DOWNLOAD/release.zip"
    else
        error "Unsupported archive format: $ASSET_NAME"
    fi

    log "Downloading (this may take a few minutes)..."
    if ! curl -fL --progress-bar "$ASSET_URL" -o "$DOWNLOAD_FILE" 2>&1 | tee -a "$INSTALLER_LOG"; then
        error "Download failed. URL: $ASSET_URL"
    fi

    if [ ! -f "$DOWNLOAD_FILE" ]; then
        error "Download file not created"
    fi

    DOWNLOAD_SIZE=$(ls -lh "$DOWNLOAD_FILE" | awk '{print $5}')
    log "Downloaded: $DOWNLOAD_SIZE"

    log "Extracting to $MAYAFLUX_INSTALL_DIR..."
    mkdir -p "$MAYAFLUX_INSTALL_DIR" || error "Failed to create $MAYAFLUX_INSTALL_DIR"

    # Extract based on file type
    if [[ "$DOWNLOAD_FILE" == *.tar.gz ]]; then
        if ! tar -xzf "$DOWNLOAD_FILE" -C "$TMPDIR_DOWNLOAD" 2>&1 | tee -a "$INSTALLER_LOG"; then
            error "Extraction failed"
        fi
    else
        if ! unzip -q "$DOWNLOAD_FILE" -d "$TMPDIR_DOWNLOAD" 2>&1 | tee -a "$INSTALLER_LOG"; then
            error "Extraction failed"
        fi
    fi

    # Move dist_staging contents to final location
    DIST_STAGING=$(find "$TMPDIR_DOWNLOAD" -type d -name "dist_staging" | head -1)

    if [ -z "$DIST_STAGING" ]; then
        error "dist_staging folder not found in archive"
    fi

    if ! cp -R "$DIST_STAGING"/* "$MAYAFLUX_INSTALL_DIR/" 2>&1 | tee -a "$INSTALLER_LOG"; then
        error "Failed to copy extracted files"
    fi

    # Verify installation
    if [ ! -f "$MAYAFLUX_INSTALL_DIR/lib/libMayaFluxLib.dylib" ]; then
        error "Verification failed - libMayaFluxLib.dylib not found"
    fi

    echo "$TAG_NAME" >"$MAYAFLUX_INSTALL_DIR/.version" || error "Failed to write version file"

    log "✅ MayaFlux $TAG_NAME installed"
fi

# ============================================================================
# STEP 3: CHECK AND INSTALL DEPENDENCIES
# ============================================================================

log "Checking dependencies..."

# Check if Homebrew exists
if ! check_command brew; then
    log "⚠️  Homebrew not found. Installing dependencies manually..."
    log "Alternatively, install Homebrew first: https://brew.sh"
    log "Then re-run: weave new <project>"
    log ""
    log "For now, skipping dependency check."
    SKIP_DEPS=true
else
    SKIP_DEPS=false
fi

if [ "$SKIP_DEPS" = false ]; then
    # Ensure brew is in PATH
    eval "$(/opt/homebrew/bin/brew shellenv)" 2>/dev/null || true

    DEPS_NEEDED=()
    for dep in ffmpeg rtaudio glfw glm eigen fmt magic_enum onedpl googletest; do
        if ! brew list "$dep" &>/dev/null 2>&1; then
            DEPS_NEEDED+=("$dep")
        fi
    done

    if [ ${#DEPS_NEEDED[@]} -eq 0 ]; then
        log "✅ All dependencies already installed"
    else
        log "Installing ${#DEPS_NEEDED[@]} dependencies..."
        if ! brew install "${DEPS_NEEDED[@]}" 2>&1 | tee -a "$INSTALLER_LOG"; then
            log "⚠️  Some dependencies failed to install. You may need to install manually."
        else
            log "✅ Dependencies installed"
        fi
    fi
fi

printf 'Installing STB headers...\n' >&3

STB_INSTALL_DIR="$HOME/Libraries/stb"
STB_HEADER_CHECK="$STB_INSTALL_DIR/stb_image.h"

if [ ! -f "$STB_HEADER_CHECK" ]; then
    mkdir -p "$STB_INSTALL_DIR"

    STB_HEADERS=(
        "stb_image.h"
        "stb_image_write.h"
        "stb_image_resize.h"
        "stb_truetype.h"
        "stb_rect_pack.h"
    )

    for header in "${STB_HEADERS[@]}"; do
        header_url="https://raw.githubusercontent.com/nothings/stb/master/$header"
        header_path="$STB_INSTALL_DIR/$header"

        if ! curl -fL "$header_url" -o "$header_path" 2>/dev/null; then
            err "Failed to download STB header: $header"
        fi
    done

    printf 'STB headers installed to %s\n' "$STB_INSTALL_DIR" >&3
else
    printf 'STB already installed at %s\n' "$STB_INSTALL_DIR" >&3
fi

# ============================================================================
# STEP 4: VULKAN SDK
# ============================================================================

VULKAN_SDK_ROOT="$HOME/VulkanSDK"
if [ -d "$VULKAN_SDK_ROOT" ] && [ -n "$(find "$VULKAN_SDK_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null)" ]; then
    log "✅ Vulkan SDK already installed"
else
    log "Installing Vulkan SDK..."

    # Fetch latest SDK version
    SDK_VERSION=$(curl -fsSL https://vulkan.lunarg.com/sdk/latest/mac.txt 2>&1) || {
        log "⚠️  Could not fetch Vulkan SDK version, skipping"
        SDK_VERSION=""
    }

    if [ -n "$SDK_VERSION" ]; then
        SDK_URL="https://sdk.lunarg.com/sdk/download/${SDK_VERSION}/mac/vulkan_sdk.zip"

        TMPDIR_VULKAN=$(mktemp -d) || error "Failed to create Vulkan temp directory"
        trap 'rm -rf "$TMPDIR_VULKAN"' EXIT

        log "Downloading Vulkan SDK v$SDK_VERSION..."
        if curl -fL "$SDK_URL" -o "$TMPDIR_VULKAN/vulkan_sdk.zip" 2>&1 | tee -a "$INSTALLER_LOG"; then
            if unzip -q "$TMPDIR_VULKAN/vulkan_sdk.zip" -d "$TMPDIR_VULKAN" 2>&1; then
                INSTALLER_APP=$(find "$TMPDIR_VULKAN" -name "*.app" -type d | head -n1)
                if [ -n "$INSTALLER_APP" ]; then
                    mkdir -p "$VULKAN_SDK_ROOT/$SDK_VERSION"
                    sudo "$INSTALLER_APP/Contents/MacOS/$(basename "$INSTALLER_APP" .app)" \
                        --root "$VULKAN_SDK_ROOT/$SDK_VERSION" \
                        --accept-licenses --default-answer --confirm-command install \
                        com.lunarg.vulkan.core com.lunarg.vulkan.usr 2>&1 | tee -a "$INSTALLER_LOG" || true
                    log "✅ Vulkan SDK configured"
                fi
            fi
        fi
    fi
fi

# ============================================================================
# STEP 5: ENVIRONMENT SETUP
# ============================================================================

log "Configuring environment..."

ZSHENV="${ZDOTDIR:-$HOME}/.zshenv"
touch "$ZSHENV" || error "Failed to create $ZSHENV"

append_if_missing() {
    if ! grep -Fq "$1" "$ZSHENV" 2>/dev/null; then
        echo "$1" >>"$ZSHENV" || error "Failed to update $ZSHENV"
    fi
}

append_if_missing "# MayaFlux Environment (added by Weave installer)"
append_if_missing "export MAYAFLUX_ROOT=\"$MAYAFLUX_INSTALL_DIR\""
append_if_missing "export PATH=\"\$MAYAFLUX_ROOT/bin:\$HOME/.local/bin:\$PATH\""
append_if_missing "export CMAKE_PREFIX_PATH=\"\$MAYAFLUX_ROOT:\$CMAKE_PREFIX_PATH\""

# Vulkan
VULKAN_SDK_PATH=$(find "$VULKAN_SDK_ROOT" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | head -n1)
if [ -n "$VULKAN_SDK_PATH" ]; then
    append_if_missing "export VULKAN_SDK=\"$VULKAN_SDK_PATH/macOS\""
    append_if_missing "export PATH=\"\$VULKAN_SDK/bin:\$PATH\""
    append_if_missing "export DYLD_LIBRARY_PATH=\"\$VULKAN_SDK/lib:\$DYLD_LIBRARY_PATH\""
    append_if_missing "export VK_ICD_FILENAMES=\"\$VULKAN_SDK/etc/vulkan/icd.d/MoltenVK_icd.json\""
    append_if_missing "export VK_LAYER_PATH=\"\$VULKAN_SDK/etc/vulkan/explicit_layer.d\""
fi

append_if_missing "export STB_ROOT=\"$HOME/Libraries\""
append_if_missing 'export CMAKE_PREFIX_PATH="$STB_ROOT:$CMAKE_PREFIX_PATH"'
append_if_missing 'export CPATH="$STB_ROOT/:$CPATH"'

LLVM_PREFIX="$(brew --prefix llvm 2>/dev/null || true)"
if [ -n "$LLVM_PREFIX" ]; then
    if ! grep -Fq "$LLVM_PREFIX/bin" "$ZSHENV" 2>/dev/null; then
        {
            echo ''
            echo '# LLVM setup for CMake / llvm-config'
            echo "export PATH=\"$LLVM_PREFIX/bin:\$PATH\""
            echo "export CMAKE_PREFIX_PATH=\"$LLVM_PREFIX/lib/cmake:\$CMAKE_PREFIX_PATH\""
            echo "export LLVM_DIR=\"$LLVM_PREFIX/lib/cmake/llvm\""
            echo "export Clang_DIR=\"$LLVM_PREFIX/lib/cmake/clang\""
        } >>"$ZSHENV"
    fi
fi

append_if_missing "# END: MayaFlux Environment (added by Weave installer)"

log "✅ Environment configured"

# ============================================================================
# STEP 6: INSTALL WEAVE TEMPLATES AND TOOL
# ============================================================================

log "Installing Weave templates and project creator..."

WEAVE_SHARE="$MAYAFLUX_INSTALL_DIR/share/weave"
mkdir -p "$WEAVE_SHARE/templates" || error "Failed to create templates directory"

# Templates are installed to /Library/Weave/templates (or ~/Library/Weave for user installs)
if [ ! -d "$WEAVE_LOCATION/templates" ]; then
    error "Templates not found at $WEAVE_LOCATION/templates"
fi

if ! cp -R "$WEAVE_LOCATION/templates/"* "$WEAVE_SHARE/templates/" 2>&1 | tee -a "$INSTALLER_LOG"; then
    error "Failed to copy templates from $WEAVE_LOCATION/templates"
fi

log "✅ Templates installed from $WEAVE_LOCATION"

# Install weave tool
mkdir -p "$WEAVE_BIN" || error "Failed to create $WEAVE_BIN"

if [ ! -f "$WEAVE_LOCATION/project_creator.sh" ]; then
    error "Weave tool not found at $WEAVE_LOCATION/project_creator.sh"
fi

if ! cp "$WEAVE_LOCATION/project_creator.sh" "$WEAVE_BIN/weave" 2>&1 | tee -a "$INSTALLER_LOG"; then
    error "Failed to copy weave tool from $WEAVE_LOCATION/project_creator.sh"
fi

chmod +x "$WEAVE_BIN/weave" || error "Failed to make weave executable"

log "✅ Weave tool installed"

# ============================================================================
# COMPLETION
# ============================================================================

log ""
log "=========================================="
log "  ✅ MayaFlux Installation Complete!"
log "=========================================="
log ""
log "Next steps:"
log "  1. Restart your terminal or run:"
log "     source ~/.zshenv"
log ""
log "  2. Create a new project:"
log "     weave new MyProject ~/Projects/"
log ""
log "  3. Build and run:"
log "     cd ~/Projects/MyProject"
log "     mkdir build && cd build"
log "     cmake .. && make"
log "     ./MyProject"
log ""
log "Documentation: https://github.com/MayaFlux/MayaFlux"
log "Installation log: $INSTALLER_LOG"
log ""

exit 0
