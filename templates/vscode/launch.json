{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug @PROJECT_NAME@",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/@PROJECT_NAME@",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "MAYAFLUX_ROOT",
                    "value": "${env:MAYAFLUX_ROOT}"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build Project"
        },
        {
            "name": "Debug @PROJECT_NAME@ (with audio logging)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/@PROJECT_NAME@",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [
                {
                    "name": "MAYAFLUX_ROOT",
                    "value": "${env:MAYAFLUX_ROOT}"
                },
                {
                    "name": "MAYAFLUX_DEBUG",
                    "value": "1"
                }
            ],
            "externalConsole": false,
            "MIMode": "lldb",
            "preLaunchTask": "Build Project"
        }
    ]
}
