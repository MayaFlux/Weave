{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure",
      "type": "cmake",
      "command": "configure",
      "preset": "release",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "cmake",
      "command": "build",
      "preset": "release",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["Configure"],
      "problemMatcher": []
    },
    {
      "label": "Clean",
      "type": "cmake",
      "command": "clean",
      "preset": "release",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Clean (destructive: deletes build dir)",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": ["-Command", "Remove-Item -Recurse -Force build -ErrorAction SilentlyContinue"]
      },
      "osx": {
        "command": "rm",
        "args": ["-rf", "build"]
      },
      "linux": {
        "command": "rm",
        "args": ["-rf", "build"]
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
