{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-B", "build",
        "-S", ".",
        "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
        "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--parallel"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "dependsOn": ["Configure"],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--target", "clean"],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Clean (destructive: deletes build dir)",
      "type": "shell",
      "windows": {
        "command": "powershell",
        "args": ["-Command", "Remove-Item -Recurse -Force build -ErrorAction SilentlyContinue"]
      },
      "osx": {
        "command": "rm",
        "args": ["-rf", "build"]
      },
      "linux": {
        "command": "rm",
        "args": ["-rf", "build"]
      },
      "group": "build",
      "problemMatcher": []
    }
  ]
}
